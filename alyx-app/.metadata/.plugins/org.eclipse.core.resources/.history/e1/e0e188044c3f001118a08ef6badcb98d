package com.alyx.security.dto;

import com.alyx.auth.entity.AppUser;
import java.time.LocalDateTime;
import java.util.List;

public record UserRoleAssignmentDto(
    Long          userId,
    String        username,
    String        fullName,
    String        email,
    String        roles,
    List<String>  roleList,
    String        isActive,
    LocalDateTime createdAt,
    LocalDateTime updatedAt,
    String        createdBy
) {
    public static UserRoleAssignmentDto from(AppUser u) {
        return new UserRoleAssignmentDto(
            u.getUserId(),
            u.getUsername(),
            u.getFullName(),
            u.getEmail(),
            u.getRoles(),
            u.getRoleList(),
            u.getIsActive(),
            u.getCreatedAt(),
            u.getUpdatedAt(),
            u.getCreatedBy()
        );
    }
}
